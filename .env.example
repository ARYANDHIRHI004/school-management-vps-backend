PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_management

BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Allow POST /api/auth/sign-up/email (keep false in production; first admin via CLI)
AUTH_ALLOW_PUBLIC_SIGNUP=false

# Optional: override default seed admins (dev only — run npm run db:seed)
SEED_ADMIN1_EMAIL=admin@school.local
SEED_ADMIN1_PASSWORD=Admin@123456
SEED_ADMIN1_NAME=School Admin
SEED_ADMIN2_EMAIL=admin2@school.local
SEED_ADMIN2_PASSWORD=Admin2@123456
SEED_ADMIN2_NAME=Deputy Admin

# Comma-separated origins for CORS (frontend URLs)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:3000
UPLOAD_DIR=uploads

# MSG91 SMS (fee alerts) — map flow template variables VAR1=name, VAR2=title, VAR3=message
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DEFAULT_COUNTRY_CODE=91
MSG91_FLOW_ID_DUE_REMINDER=
MSG91_FLOW_ID_OVERDUE=
MSG91_FLOW_ID_PAYMENT=
MSG91_FLOW_ID_CUSTOM=