PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_management

BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated origins for CORS (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=uploads

# MSG91 SMS (fee alerts) — map flow template variables VAR1=name, VAR2=title, VAR3=message
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DEFAULT_COUNTRY_CODE=91
MSG91_FLOW_ID_DUE_REMINDER=
MSG91_FLOW_ID_OVERDUE=
MSG91_FLOW_ID_PAYMENT=
MSG91_FLOW_ID_CUSTOM=